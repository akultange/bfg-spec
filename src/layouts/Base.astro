---
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";
// The two Latin font files every page uses. Preloading them starts the downloads with the HTML,
// instead of after the stylesheet is read, so the swap from the fallback font happens sooner.
import serifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansLatin from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "A portfolio concept by Luka Skhiladze and Giorgi Kheladze. Kindtill is a fictional brand." } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B2540" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="specbar" role="note" aria-label="About this page">
      <b>SPEC</b>
      <span class="specbar__long">Portfolio concept by Luka Skhiladze and Giorgi Kheladze. Kindtill is a fictional brand.</span>
      <span class="specbar__short">Portfolio concept. Kindtill is a fictional brand.</span>
    </div>
    <slot />
  </body>
</html>
